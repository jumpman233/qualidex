{
  "name": "qualidex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run rebuild:native && vite",
    "build": "tsc && vite build",
    "package": "pnpm run build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "cleanup:import-pollution": "node --no-warnings=ExperimentalWarning scripts/cleanup-import-pollution.mjs",
    "verify:scan": "node scripts/verify-scan.mjs",
    "verify:hash": "node scripts/verify-hash.mjs",
    "verify:text-extract": "node scripts/verify-text-extract.mjs",
    "verify:ocr-ai-real": "node scripts/verify-ocr-ai-real.mjs",
    "verify:ai-extract": "node scripts/verify-ai-extract.mjs",
    "verify:id-card-privacy": "node scripts/verify-id-card-privacy.mjs",
    "verify:excel-export": "node scripts/verify-excel-export.mjs",
    "verify:import-batches": "node scripts/verify-import-batches.mjs",
    "verify:processing-queue": "node scripts/verify-processing-queue.mjs",
    "verify:processing-worker": "node scripts/verify-processing-worker.mjs",
    "verify:processing-worker-ai-success": "node scripts/verify-processing-worker-ai-success.mjs",
    "verify:structured-recognition": "node scripts/verify-structured-recognition.mjs",
    "verify:archive-preview": "node scripts/verify-archive-preview.mjs",
    "verify:archive-write": "node scripts/verify-archive-write.mjs",
    "verify:review-list": "node scripts/verify-review-list.mjs",
    "verify:review-actions": "node scripts/verify-review-actions.mjs",
    "verify:review-field-update": "node scripts/verify-review-field-update.mjs",
    "verify:review-license-update": "node scripts/verify-review-license-update.mjs",
    "verify:review-create-person": "node scripts/verify-review-create-person.mjs",
    "verify:review-person-reassign": "node scripts/verify-review-person-reassign.mjs",
    "verify:people-merge": "node scripts/verify-people-merge.mjs",
    "verify:query-export-recycle": "node scripts/verify-query-export-recycle.mjs",
    "verify:p1": "pnpm run verify:import-batches && pnpm run verify:processing-worker && pnpm run verify:processing-worker-ai-success && pnpm run verify:id-card-privacy && pnpm run verify:structured-recognition && pnpm run verify:archive-preview && pnpm run verify:archive-write && pnpm run verify:review-list && pnpm run verify:review-actions && pnpm run verify:review-field-update && pnpm run verify:review-license-update && pnpm run verify:review-person-reassign && pnpm run verify:review-create-person && pnpm run verify:people-merge && pnpm run verify:query-export-recycle && pnpm run lint && pnpm run build",
    "verify:db": "pnpm run rebuild:native && node scripts/verify-db.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "lucide-react": "^1.16.0",
    "pdf-poppler": "^0.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite-vec": "^0.1.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
